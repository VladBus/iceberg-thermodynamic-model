@phdthesis{buseuCalculationSeasonalEvolution2024,
	address = {Saint Petersburg},
	type = {Bachelor of {Science}},
	title = {Calculation of the seasonal evolution of the sea ice thickness distribution function},
	url = {http://elib.rshu.ru/search_vkr/?s=%D0%91%D1%83%D1%81%D0%B5%D0%B2},
	doi = {10.13140/RG.2.2.28338.47047},
	abstract = {Background: Sea ice thickness is a critical parameter of the ice cover, characterized by significant spatial and temporal heterogeneity driven by thermodynamic and dynamic factors. Accurately describing the seasonal evolution of ice thickness distribution is essential for improving numerical models and supporting economic activities in the Arctic region.

Methods: This study utilizes a numerical modeling approach implemented in Fortran to simulate the seasonal evolution of the ice thickness distribution function. The model accounts for thermal and dynamic processes within the ice cover. The study focuses on the East Siberian and Kara Seas, which are characterized by near-perennial ice cover, making them ideal subjects for analyzing ice thickness variability.

Objectives: The primary goal of this research is to simulate the seasonal evolution of the sea ice thickness distribution function. Key tasks included:
Characterizing the physical and geographical features of the study areas.
Analyzing seasonal hydrometeorological conditions, specifically surface air temperature trends.
Modeling the thermodynamic and dynamic interaction of the ice cover.
Calculating and validating the ice thickness distribution function.

Results: The developed numerical implementation allows for a detailed analysis of ice cover processes. The results provide insights into the seasonal dynamics of the Arctic cryosphere and can be used to minimize economic and environmental risks in polar maritime operations.},
	language = {ru},
	urldate = {2026-03-03},
	school = {Russian State Hydrometeorological University},
	author = {Buseu, Uladzislau},
	month = jun,
	year = {2024},
	langid = {russian},
}

@article{silvaContributionGiantIcebergs2006,
	title = {Contribution of giant icebergs to the {Southern} {Ocean} freshwater flux},
	volume = {111},
	copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
	issn = {0148-0227},
	url = {https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2004JC002843},
	doi = {10.1029/2004JC002843},
	abstract = {In the period 1979–2003 the mass of “giant” icebergs (icebergs larger than 18.5 km in length) calving from Antarctica averaged 1089 ± 300 Gt yr −1 of ice, under half the snow accumulation over the continent given by the Intergovernmental Panel on Climate Change (2246 ± 86 Gt yr −1). Here we combine a database of iceberg tracks from the National Ice Center and a model of iceberg thermodynamics in order to estimate the amount and distribution of meltwater attributable to giant icebergs. By comparing with published modeled meltwater distribution for smaller bergs we show that giant icebergs have a different melting pattern: An estimated 35\% of giant icebergs' mass is exported north of 63°S versus 3\% for smaller bergs, although giant bergs spend more of the earlier part of their history nearer to the coast. We combine both estimates to produce the first iceberg meltwater map that takes into account giant icebergs. The average meltwater input is shown to exceed precipitation minus evaporation (P − E) in certain areas and is a nonnegligible term in the balance of freshwater fluxes in the Southern Ocean. The calving of giant icebergs is, however, episodic; this might have implications for their impact on the freshwater budget of the ocean. It is estimated that over the period 1987–2003 the meltwater flux in the Weddell and Ross seas has varied by at least 15,000 m3 s −1 over a month. Because of the potential sensitivity of the production of deep waters to abrupt changes in the freshwater budget, variations in iceberg melt rates of this magnitude might be climatologically significant.},
	language = {en},
	number = {C3},
	urldate = {2026-03-03},
	journal = {Journal of Geophysical Research: Oceans},
	author = {Silva, T. A. M. and Bigg, G. R. and Nicholls, K. W.},
	month = mar,
	year = {2006},
	pages = {2004JC002843},
	langid = {english},
}

