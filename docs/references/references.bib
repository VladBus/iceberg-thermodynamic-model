@book{lepparantaDriftSeaIce2011,
	address = {Heidelberg ; New York : Chichester, UK},
	edition = {2nd ed},
	series = {Springer-{Praxis} books in geophysical sciences},
	title = {The drift of sea ice},
	isbn = {978-3-642-04682-7},
	abstract = {"This new edition of 'The Drift of Sea Ice' brings the theory, observations and practical applications of research into sea ice drift completely up to date, taking in to account and discussing the many new scientific results which have been published, in particular connected with thermodynamics, ice-ocean interaction, scaling, and numerical model applications in short-term and climate forecasting. This revised and expanded text presents the geophysical theory, observations from field programs, mathematical modelling techniques, and applications of sea ice drift science. It shows how the fundamental laws of sea ice drift come from the material properties of sea ice and the basic laws of mechanics. The book provides detailed analytical modelling and mathematical models and presents the construction of numerical ice drift models"--P. [4] of cover},
