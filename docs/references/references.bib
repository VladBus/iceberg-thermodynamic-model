	url = {https://linkinghub.elsevier.com/retrieve/pii/S146350031100062X},
	doi = {10.1016/j.ocemod.2011.03.004},
	abstract = {The variability of small-size iceberg distributions is revealed from a novel analysis of satellite altimeter data. A strong annual cycle is modulated by pulse-like events confined to single ocean basins, with dense iceberg populations in the South Atlantic in 2004–2005, and in the South Pacific in 2008. Anomalies in sea surface temperatures of the order of 1 °C may be related to the iceberg distribution. Icebergs also appear very strongly associated with anomalies in the heights of ocean waves. A preliminary parameterization of wave blocking by icebergs significantly reduces wave model errors in the region south of 45° South, and has a perceptible influence on all the west coasts of the Southern hemisphere.},
	language = {en},
	number = {3-4},
	urldate = {2026-02-24},
	journal = {Ocean Modelling},
	author = {Ardhuin, Fabrice and Tournadre, Jean and Queffeulou, Pierre and Girard-Ardhuin, Fanny and Collard, Fabrice},
	year = {2011},
	pages = {405--410},
	langid = {english},
}

