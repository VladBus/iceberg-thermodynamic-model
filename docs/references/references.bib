@article{collaresIcebergDriftOcean2018,
	title = {Iceberg drift and ocean circulation in the northwestern {Weddell} {Sea}, {Antarctica}},
	volume = {149},
	issn = {09670645},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0967064517302485},
	doi = {10.1016/j.dsr2.2018.02.014},
	abstract = {Icebergs are distinctive features in the Southern Ocean and can inﬂuence the physicochemical properties of the ocean environment around them. Their trajectories are inﬂuenced by ocean currents, sea ice, bathymetry and wind action. Here, twenty-ﬁve icebergs were identiﬁed and tracked by applying image classiﬁcation methods to a series of 142 Advanced Synthetic Aperture Radar (ASAR) images obtained during 2008 and 2009. Tracking these icebergs made it possible to associate the patterns of iceberg drift with the main ocean currents and front systems in this region, including the Antarctic Coastal Current, the Antarctic Slope Front and the Weddell Front. A case study investigated here revealed the recirculation of a Weddell Sea iceberg within the Bransﬁeld Strait in the Northern Antarctic Peninsula as well as its corresponding mass loss starting in the Weddell Sea and extending throughout the monitoring period. The icebergs studied experienced an average disintegration percentage of 21.15\% and an average drift speed of 0.22 ± 0.11 km h–1. The icebergs that drifted at least 500 km had an average meltwater injection rate of 62.76 ± 38.27 m3 s–1 in the ocean around the Northern Antarctic Peninsula.},
	language = {en},
	urldate = {2026-02-24},
	journal = {Deep Sea Research Part II: Topical Studies in Oceanography},
	author = {Collares, Lorena L. and Mata, Mauricio M. and Kerr, Rodrigo and Arigony-Neto, Jorge and Barbat, Mauro M.},
	month = mar,
	year = {2018},
	pages = {10--24},
	langid = {english},
}

