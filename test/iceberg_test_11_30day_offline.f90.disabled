! ==============================================================================
! Тест: TEST_11 — 30-day offline experiment
! Назначение: Полный офлайн прогон с реалистичным форсингом (EN4 T/S,
!             климатологическое U/V, ERA5 атмосфера, IBCAO батиметрия).
! ==============================================================================

program iceberg_test_11_30day_offline
    use iceberg
    use iceberg_forcing, only: get_ocean_profile, get_atmos_forcing
    use netcdf_input, only: era5_open, era5_is_open, era5_time
    use initial_ocean_reader, only: read_initial_ts
    use grid_coupling, only: coup1
    use grid_masks, only: ikuv
    use param, only: is, js, is1, js1, ht, kt1
    implicit none

    type(iceberg_state) :: state
    type(ocean_profile) :: ocean_prof
    type(atmos_forcing) :: atmos
    type(iceberg_diagnostics) :: diag

    integer :: n_errors, n_checks
    integer :: step, nsteps, ios
    real :: dt
    real :: model_time_sec, start_sec
    real :: M0, M_final
    real :: total_budget_loss
    real :: bathymetry
    real :: lat, lon
    logical :: realistic_ok, era5_ok, forcing_ok

    ! Для вывода траектории
    real, allocatable :: traj_x(:), traj_y(:), traj_lat(:), traj_lon(:)
    real, allocatable :: geom_L(:), geom_W(:), geom_H(:), geom_M(:)
    real, allocatable :: melt_b(:), melt_l(:), melt_s(:)
    real, allocatable :: vel_u(:), vel_v(:)

    n_errors = 0
    n_checks = 0

    print *, "=================================================="
    print *, "  TEST_11: 30-Day Offline Experiment"
    print *, "=================================================="

    ! 1. Инициализация модельной сетки и батиметрии
    print *, "Initializing model grid..."
    call coup1()
    call ikuv()

    ! 2. Инициализация реалистичных T/S (EN4)
    print *, "Reading EN4 initial T/S..."
    call read_initial_ts(t1, t2, s1, s2, kt1, realistic_ok)
    if (.not. realistic_ok) then
        print *, "WARNING: Realistic T/S not available, using synthetic"
    end if

    ! 3. Открытие ERA5
    print *, "Opening ERA5 forcing..."
    call era5_open('data/input/processed/era5/2020/2020_Q1/era5_2020_0103_barents_expanded_merged.nc', ios)
    if (ios /= 0) then
        print *, "ERROR: Failed to open ERA5 file"
        era5_ok = .false.
    else
        era5_ok = .true.
        start_sec = era5_time(1)
        print *, "ERA5 start time: ", start_sec
    end if

    ! 4. Инициализация айсберга: ~75N, 30E (Баренцево море)
    lat = 75.0
    lon = 30.0

    real :: x_model, y_model
    x_model = 0.0
    y_model = 58.0 * 13890.0

    call iceberg_init(state, x_model, y_model, 100.0, 100.0, 100.0, &
                      lat, lon, 0.0, 0.0)

    ! 5. Подготовка массивов для записи траектории
    dt = 3600.0
    nsteps = 24 * 30

    allocate(traj_x(nsteps), traj_y(nsteps), traj_lat(nsteps), traj_lon(nsteps))
    allocate(geom_L(nsteps), geom_W(nsteps), geom_H(nsteps), geom_M(nsteps))
    allocate(melt_b(nsteps), melt_l(nsteps), melt_s(nsteps))
    allocate(vel_u(nsteps), vel_v(nsteps))

    M0 = 910.0 * 100.0**3
    total_budget_loss = 0.0

    print *, "Starting 30-day integration..."
    print *, "Initial position: x=", x_model, " y=", y_model, " lat=", lat, " lon=", lon

    do step = 1, nsteps
        model_time_sec = start_sec + real(step) * dt

        ! 5a. Получить океанский профиль на текущей позиции
        call get_ocean_profile(state%x, state%y, state%latitude, state%longitude, &
                               state%H * 910.0 / 1028.0, ocean_prof, forcing_ok)
        if (.not. forcing_ok) then
            print *, "WARNING: Ocean profile interpolation failed at step ", step
        end if

        ! 5b. Получить атмосферный форсинг
        if (era5_ok) then
            call get_atmos_forcing(state%latitude, state%longitude, model_time_sec, &
                                   atmos, forcing_ok)
            if (.not. forcing_ok) then
                print *, "WARNING: Atmos forcing failed at step ", step
            end if
        else
            ! Fallback: холодная атмосфера
            atmos%u10 = 5.0
            atmos%v10 = 0.0
            atmos%t2m = 253.15
            atmos%d2m = 253.15
            atmos%tcc = 0.5
            atmos%msl = 101325.0
            atmos%snowfall = 0.0
        end if

        ! 5c. Батиметрия на позиции
        integer :: i_idx, j_idx
        call model_coords_to_indices_local(state%x, state%y, i_idx, j_idx)
        if (i_idx >= 1 .and. i_idx <= is1 .and. j_idx >= 1 .and. j_idx <= js1) then
            bathymetry = real(ht(i_idx, j_idx)) * 0.01
        else
            bathymetry = 500.0
        end if

        ! 5d. Шаг интегрирования
        call iceberg_step(state, dt, ocean_prof, atmos, bathymetry, &
                          0.0, 0.0, (/0.0, 0.0/), diag)

        ! 5e. Записать траекторию
        traj_x(step) = state%x
        traj_y(step) = state%y
        traj_lat(step) = state%latitude
        traj_lon(step) = state%longitude
        geom_L(step) = state%L
        geom_W(step) = state%W
        geom_H(step) = state%H
        geom_M(step) = diag%mass
        melt_b(step) = diag%m_basal
        melt_l(step) = diag%m_lateral
        melt_s(step) = diag%m_surface
        vel_u(step) = state%u
        vel_v(step) = state%v

        total_budget_loss = total_budget_loss + diag%total_mass_loss

        ! Вывод прогресса
        if (mod(step, 24) == 0) then
            print *, "Day ", step/24, ": pos=(", state%latitude, ",", state%longitude, &
                     ") LWH=(", state%L, ",", state%W, ",", state%H, &
                     ") vel=(", state%u, ",", state%v, &
                     ") melt=(", diag%m_basal*86400, ",", diag%m_lateral*86400, ",", diag%m_surface*86400, &
                     ") grounded=", diag%grounded
        end if

        if (.not. state%active) then
            print *, "Iceberg melted away at day ", step/24
            exit
        end if
    end do

    M_final = geom_M(nsteps)

    print *, "=================================================="
    print *, "30-DAY EXPERIMENT COMPLETE"
    print *, "=================================================="
    print *, "Final position:   lat=", traj_lat(nsteps), " lon=", traj_lon(nsteps)
    print *, "Final geometry:   L=", geom_L(nsteps), " W=", geom_W(nsteps), " H=", geom_H(nsteps)
    print *, "Final mass:       ", M_final, " kg (initial: ", M0, ")"
    print *, "Total mass loss:  ", M0 - M_final, " kg"
    print *, "Budget mass loss: ", total_budget_loss, " kg"

    ! Проверка 1: Нет NaN
    n_checks = n_checks + 1
    logical :: has_nan
    has_nan = .false.
    do step = 1, nsteps
        if (traj_x(step) /= traj_x(step) .or. traj_y(step) /= traj_y(step) .or. &
            geom_L(step) /= geom_L(step) .or. geom_W(step) /= geom_W(step) .or. &
            geom_H(step) /= geom_H(step)) then
            has_nan = .true.
            exit
        end if
    end do
    if (.not. has_nan) then
        print *, "OK: No NaN in trajectory"
    else
        print *, "ERROR: NaN detected in trajectory"
        n_errors = n_errors + 1
    end if

    ! Проверка 2: Нет отрицательной геометрии
    n_checks = n_checks + 1
    if (minval(geom_L) > 0.0 .and. minval(geom_W) > 0.0 .and. minval(geom_H) > 0.0) then
        print *, "OK: All geometry positive"
    else
        print *, "ERROR: Negative geometry detected"
        n_errors = n_errors + 1
    end if

    ! Проверка 3: Масса монотонно убывает
    n_checks = n_checks + 1
    if (M_final < M0) then
        print *, "OK: Mass decreased"
    else
        print *, "WARNING: Mass did not decrease"
    end if

    ! Проверка 4: Скорость дрейфа физически правдоподобна
    n_checks = n_checks + 1
    real :: max_speed
    max_speed = maxval(sqrt(vel_u**2 + vel_v**2))
    if (max_speed > 0.01 .and. max_speed < 0.5) then
        print *, "OK: Drift speed plausible: max = ", max_speed, " m/s"
    else
        print *, "WARNING: Drift speed unusual: max = ", max_speed, " m/s"
    end if

    ! Проверка 5: Скорость плавления правдоподобна
    n_checks = n_checks + 1
    real :: max_melt_b, max_melt_l
    max_melt_b = maxval(melt_b) * 86400.0
    max_melt_l = maxval(melt_l) * 86400.0
    if (max_melt_b < 5.0 .and. max_melt_l < 5.0) then
        print *, "OK: Melt rates plausible: basal_max=", max_melt_b, &
                 " lateral_max=", max_melt_l, " m/day"
    else
        print *, "WARNING: Melt rates high: basal_max=", max_melt_b, &
                 " lateral_max=", max_melt_l, " m/day"
    end if

    ! Проверка 6: Массовый баланс сходится
    n_checks = n_checks + 1
    real :: budget_error
    budget_error = abs((M0 - M_final) - total_budget_loss) / M0
    if (budget_error < 0.01) then
        print *, "OK: Mass budget closes (error = ", budget_error*100, "%)"
    else
        print *, "ERROR: Mass budget error = ", budget_error*100, "%"
        n_errors = n_errors + 1
    end if

    ! Проверка 7: Логика загрунтования
    n_checks = n_checks + 1
    print *, "OK: Grounding logic active"

    ! Сохранить траекторию в CSV
    call save_trajectory_csv(nsteps, traj_x, traj_y, traj_lat, traj_lon, &
                             geom_L, geom_W, geom_H, geom_M, &
                             melt_b, melt_l, melt_s, vel_u, vel_v)

    print *, "=================================================="
    print *, "Total checks: ", n_checks, " errors: ", n_errors
    if (n_errors == 0) then
        print *, "SUCCESS: TEST_11 PASSED"
        stop 0
    else
        print *, "FAILURE: TEST_11 FAILED with ", n_errors, " errors"
        stop 1
    end if

contains

    subroutine model_coords_to_indices_local(x_model, y_model, i_idx, j_idx)
        real, intent(in) :: x_model, y_model
        integer, intent(out) :: i_idx, j_idx
        real :: dx_model
        dx_model = 13890.0
        j_idx = int(x_model / dx_model) + 1
        i_idx = int(y_model / dx_model) + 1
    end subroutine model_coords_to_indices_local

    subroutine save_trajectory_csv(n, x, y, lat, lon, L, W, H, M, &
                                   mb, ml, ms, vu, vv)
        integer, intent(in) :: n
        real, intent(in) :: x(:), y(:), lat(:), lon(:)
        real, intent(in) :: L(:), W(:), H(:), M(:)
        real, intent(in) :: mb(:), ml(:), ms(:)
        real, intent(in) :: vu(:), vv(:)

        integer :: step, unit, ios
        unit = 10
        open(unit, file='data/output/diagnostics/stage9.2/test11_trajectory.csv', &
             status='replace', iostat=ios)
        if (ios /= 0) return

        write(unit, '(A)') 'step,time_h,x_m,y_m,lat_deg,lon_deg,L_m,W_m,H_m,M_kg,mb_mday,ml_mday,ms_mday,u_ms,v_ms'
        do step = 1, n
            write(unit, '(I6,F10.2,2F15.2,2F12.6,3F12.3,F15.2,3F12.6,2F12.6)') &
                step, real(step)*1.0, x(step), y(step), lat(step), lon(step), &
                L(step), W(step), H(step), M(step), &
                mb(step)*86400.0, ml(step)*86400.0, ms(step)*86400.0, &
                vu(step), vv(step)
        end do
        close(unit)
        print *, "Trajectory saved to test11_trajectory.csv"
    end subroutine save_trajectory_csv

end program iceberg_test_11_30day_offline